{
  "name": "spellbook",
  "version": "6.0.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "src/bounty",
    "src/digestify",
    "src/grapevine",
    "src/scriptorium"
  ],
  "scripts": {
    "build": "bun run src/build.ts",
    "format": "biome format --write .",
    "format:md": "prettier --write '**/*.md'",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "biome check --error-on-warnings . && bun run docs:check",
    "docs:check": "bun scripts/pdocs/cli.ts check --format text",
    "prepare": "husky",
    "land-check": "bun scripts/land-check.ts",
    "prune-branches": "git branch --merged | grep -vE '^[*+]|main$|develop$' | xargs -r git branch -d",
    "test": "bun test --parallel --timeout=15000 --timings=test-timings.json",
    "test:timings": "rm -f test-timings.json && bun test --parallel --timings=test-timings.json --update-timings",
    "gate": "bun run build && bun run check && bun run test"
  },
  "lint-staged": {
    "*.{ts,tsx,json,jsonc}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ],
    "*.md": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "latest",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "agent-cli-conformance": "git+https://github.com/ichabodcole/agent-cli-conformance.git#v0.1.15",
    "bun": "1.4.0",
    "bun-plugin-tailwind": "^0.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0"
  },
  "overrides": {
    "happy-dom": "20.14.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@dagrejs/dagre": "^3.0.0",
    "@headless-tree/core": "^1.7.0",
    "@headless-tree/react": "^1.7.0",
    "@lezer/highlight": "1.2.5",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.17.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.4",
    "sharp": "^0.35.4",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0"
  }
}
