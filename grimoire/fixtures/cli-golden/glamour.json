    {
      "argv": ["--help"],
      "exit": 0,
      "verdict": "accepted",
      "stream": "stdout",
      "text": [
        "glamour — a grounded visual conversation surface.",
        "",
        "  open [--title ..] [--intent ..] [--no-open] [--timeout ..] [--start-timeout ..] [--restore ..]",
        "                                                spawn a session (opens the browser); prints {url, port, session_id}",
        "  tail [--since ..] [--once]                    SSE user events → JSONL (wrap with Monitor; waits for a session, never exits 5); ends itself before Monitor's 30-minute cap with a line naming the next act; a human watching a terminal keeps it open with SPELLBOOK_TAIL_WINDOW_MS=0",
        "  state [--full]                                lean state snapshot (--full for raw incl. base64)",
        "  intent <text...>                              update the session intent",
        "  annotate <id> <text...>                       write agent annotation onto a library item",
        "  say <text...> [--kind ..]                     post agent dialogue into the conversation (--kind info|working|result|error)",
        "  section <key> [--status ..] [--content ..] [--prompts ..] [--colors ..]",
        "                                                shape a style-guide section (--prompts a||b; --colors \"#hex:Name||#hex:Name\")",
        "  status <on|off> [text...]                     show/hide the working spinner",
        "  gen [--url ..] [--file ..] [--src ..] [--prompt ..] [--model ..] [--round ..] [--seed ..] [--cost ..] [--label ..] [--custom ..]",
        "                                                post a generated image (one of --url|--file|--src, and --prompt --model --round required)",
        "  gen-cost <id> [--cost ..]                     backfill a generated image's cost (--cost <n> required)",
        "  gen-meta <id> [--prompt ..] [--custom ..]     backfill the real prompt / refs onto a gen (--prompt and/or --custom)",
        "  focus <id...> [--note ..]                     scope the focus lens to these items (+ --note to ask)",
        "  style-save <label...>                         codify the current style → project tray",
        "  style-archive <id> [--unarchive]              archive (or --unarchive) a saved style",
        "  tray                                          list the project's saved styles",
        "  close                                         shut down the session",
        "  info                                          print the resolved discovery JSON",
        "  schema                                        emit this CLI's acc declaration (walked from the command table)",
        "  help                                          show this message",
        "  --help | -h | --version | -V  root tokens: help, or {name, version} as JSON",
        "",
        "  Add --session <id> to any verb that talks to a session (default: most recent).",
        "  Each verb accepts only the flags on its row; a recognized flag on the wrong",
        "  verb is refused, and the rejection lists the verb's own flags.",
        "",
        "  Output: every verb prints JSON on stdout by default, one document per answer —",
        "  except tail, a stream that prints one JSON line per event, and help, which is",
        "  prose. Failures are one JSON envelope on stderr and exit non-zero (2 = usage,",
        "  1 = internal, 5 = not found, 6 = conflict) — except tail, which waits for a",
        "  session instead of failing and writes its retry/keepalive notes to stderr as",
        "  '#'-prefixed prose."
      ]
    },
